packages/torrserver_flutter/android/src/main/jniLibs/
packages/torrserver_flutter/macos/bin/
packages/torrserver_flutter/ios/TorrServerKit.xcframework/

# Planning notes, kept on the PC they were written on
/reports/
/docs/
FRONTEND_PROMPT.md

# The website (its own deliverable, with its video files; published to Cloudflare Pages, not part of the app)
/website/
/old-site-redirect/

# This build's own server addresses. The copy in the repository is
